<UserControl x:Class="Memory_Game.Views.IntroScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Memory_Game.Views"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200">

    <Grid Background="#111">  <!-- permite randuri,coloane,layering -->

        <Grid Width="1200"
              Height="900"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <!-- 2 randuri -->
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- stanga sus -->
            <Border Grid.Row="0"
                    Grid.Column="0">

                <Border.Background>
                    <ImageBrush
                        ImageSource="/Assets/Cards/board.jpg"
                        Viewbox="0,0,0.5,0.5"
                        ViewboxUnits="RelativeToBoundingBox"
                        Stretch="Fill"/>
                </Border.Background>

            </Border>

            <!-- dreapta sus -->
            <Border Grid.Row="0"  
                    Grid.Column="1">
                <!-- tine fiecare panel- animate separat -->

                <Border.Background>
                    <!-- backgroung cu imagineBrush -->
                    <ImageBrush
                        ImageSource="/Assets/Cards/board.jpg"
                        Viewbox="0.5,0,0.5,0.5"
                        ViewboxUnits="RelativeToBoundingBox"
                        Stretch="Fill"/>
                </Border.Background>

            </Border>

            <!-- stanga jos -->
            <Border Grid.Row="1"
                    Grid.Column="0">

                <Border.Background>
                    <ImageBrush
                        ImageSource="/Assets/Cards/board.jpg"
                        Viewbox="0,0.5,0.5,0.5"
                        ViewboxUnits="RelativeToBoundingBox"
                        Stretch="Fill"/>
                </Border.Background>

            </Border>

            <!-- dreapta jos -->
            <Border Grid.Row="1"
                    Grid.Column="1">

                <Border.Background>
                    <ImageBrush
                        ImageSource="/Assets/Cards/board.jpg"
                        Viewbox="0.5,0.5,0.5,0.5"
                        ViewboxUnits="RelativeToBoundingBox"
                        Stretch="Fill"/>
                </Border.Background>

            </Border>

        </Grid>


        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="Write your name:"
                FontSize="30"
                Foreground="Black"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,0,0,20" 
                Background="White" 
                Width="230"/>

            <Border
                Width="400"
                Height="45"
                CornerRadius="18"
                Background="#FFD8C1ED"
                Margin="0,0,0,30">

                <TextBox
                    x:Name="UsernameBox"
                    FontSize="25"
                    Text="Player"
                    BorderThickness="0"
                    Background="Transparent"
                    TextAlignment="Center"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Padding="10,0"/>

            </Border>

            <Border
                Background="#FF110000"
                CornerRadius="20"
                Width="400"
                Padding="10"
                Margin="0,0,0,20">

                <TextBlock
                    Text="SELECT DIFFICULTY"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="White"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"/>

            </Border>


            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <Button
                    x:Name="EasyButton"
                    Content="EASY"
                    FontSize="20"
                    Width="120"
                    Height="50"
                    Margin="10"
                    Click="EasyButton_Click" Background="#FFE6E2A3"/>

                <Button
                    x:Name="MediumButton"
                    Content="MEDIUM"
                    FontSize="20"
                    Width="120"
                    Height="50"
                    Margin="10"
                    Click="MediumButton_Click" Background="#FFCFE6A3"/>

                <Button
                    x:Name="HardButton"
                    Content="HARD"
                    FontSize="20"
                    Width="120"
                    Height="50"
                    Margin="10"
                    Click="HardButton_Click" Background="#FFE6A5A3"/>

            </StackPanel>

        </StackPanel>

        <Button
            Content="START GAME"
            FontSize="25"
            Width="220"
            Height="70"
            Click="StartButton_Click" 
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,400,0,0"
            Background="#FFA5CDE8"/>

        <Button
            Content="LEADERBOARD"
            FontSize="25"
            Width="220"
            Height="70"
            Click="Leaderboard_Click" 
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,600,0,0"
            Background="#FFF3D4B5"/>

    </Grid>
</UserControl>
