<UserControl x:Class="Memory_Game.Views.IntroScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Memory_Game.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    
    <Grid Background="#111"> <!-- permite randuri,coloane,layering -->

        <Grid Width="800"
              Height="800"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <!-- 2 randuri -->
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- stanga sus -->
            <Border Grid.Row="0"
                    Grid.Column="0">

                <Border.Background>
                    <ImageBrush
                        ImageSource="/Assets/Cards/board.jpg"
                        Viewbox="0,0,0.5,0.5"
                        ViewboxUnits="RelativeToBoundingBox"
                        Stretch="Fill"/>
                </Border.Background>

            </Border>

            <!-- dreapta sus -->
            <Border Grid.Row="0"  
                    Grid.Column="1"> <!-- tine fiecare panel- animate separat -->

                <Border.Background> <!-- backgroung cu imagineBrush -->
                    <ImageBrush
                        ImageSource="/Assets/Cards/board.jpg"
                        Viewbox="0.5,0,0.5,0.5"
                        ViewboxUnits="RelativeToBoundingBox"
                        Stretch="Fill"/>
                </Border.Background>

            </Border>

            <!-- stanga jos -->
            <Border Grid.Row="1"
                    Grid.Column="0">

                <Border.Background>
                    <ImageBrush
                        ImageSource="/Assets/Cards/board.jpg"
                        Viewbox="0,0.5,0.5,0.5"
                        ViewboxUnits="RelativeToBoundingBox"
                        Stretch="Fill"/>
                </Border.Background>

            </Border>

            <!-- dreapta jos -->
            <Border Grid.Row="1"
                    Grid.Column="1">

                <Border.Background>
                    <ImageBrush
                        ImageSource="/Assets/Cards/board.jpg"
                        Viewbox="0.5,0.5,0.5,0.5"
                        ViewboxUnits="RelativeToBoundingBox"
                        Stretch="Fill"/>
                </Border.Background>

            </Border>

        </Grid>

    </Grid>
</UserControl>
